# Run `npm run setup` to create .env with unique secrets.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://salescout:CHANGE_ME@127.0.0.1:55432/salescout
POSTGRES_PASSWORD=CHANGE_ME
SESSION_SECRET=GENERATE_WITH_NPM_RUN_SETUP
TRUST_PROXY=0
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SaleScout <noreply@localhost.test>
# For compose.prod.yaml, set your public hostname and real SMTP settings above.
DOMAIN=salescout.example.com

# Optional OAuth. Configure complete provider settings to enable its button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the .p8 key as a single quoted value with literal \n between lines.
APPLE_PRIVATE_KEY=
